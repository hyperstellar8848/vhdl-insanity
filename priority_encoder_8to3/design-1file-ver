library ieee;
use ieee.std_logic_1164.all;

entity inv is
    port (
        a : in  std_logic;
        y : out std_logic
    );
end entity inv;

architecture rtl of inv is
begin
    y <= not a;
end architecture rtl;

library ieee;
use ieee.std_logic_1164.all;

entity and2 is
    port (
        a : in  std_logic;
        b : in  std_logic;
        y : out std_logic
    );
end entity and2;

architecture rtl of and2 is
begin
    y <= a and b;
end architecture rtl;

